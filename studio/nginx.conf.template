# Rendered by the nginx image's entrypoint through envsubst. Only STAGE_UPSTREAM
# and STAGE_TOKEN are substituted (see NGINX_ENVSUBST_FILTER in the Dockerfile),
# so nginx's own $uri and $proxy_add_x_forwarded_for survive intact.
server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  # The stage executor runs on the sealed cartridge lab VM and is reachable only
  # across the VPC. The browser never holds its credential: this proxy attaches
  # it on the way through, exactly as the Vite dev server does locally.
  location /api/stages/ {
    proxy_pass http://${STAGE_UPSTREAM}/;
    proxy_set_header Authorization "Bearer ${STAGE_TOKEN}";

    # The executor rate-limits per caller as a courtesy. It cannot trust this
    # value and does not rely on it; the cap that protects spend is global.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_http_version 1.1;
    proxy_connect_timeout 15s;
    # Embedding a table runs well past any default timeout, and a dropped socket
    # reads to the visitor as a failed stage rather than a slow one.
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
  }

  # The Go control plane runs beside the executor on the lab VM, because its
  # /internal/v1 doors require a loopback caller and the frame producer has to
  # be on that host. Only /api/web/v1 is exposed there, and the demo identity is
  # attached here rather than shipped to the browser.
  location /api/web/v1/ {
    proxy_pass http://${WEB_BFF_UPSTREAM};
    proxy_set_header Authorization "Bearer ${WEB_BFF_TOKEN}";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_http_version 1.1;
    proxy_connect_timeout 15s;
    # The terminal mirrors are server-sent events. Buffering them would hold
    # every frame until the stream closed, which is the same as no mirror.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Everything else is the built single-page app. The fallback keeps client-side
  # routes working on a hard refresh.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
