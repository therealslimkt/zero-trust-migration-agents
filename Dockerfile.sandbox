FROM python:3.11-slim

WORKDIR /app

COPY sandbox_mcp.py /app/

# Install Apache Beam, MCP dependencies, and uvicorn for Cloud Run
RUN pip install --no-cache-dir apache-beam[gcp] mcp==1.29.0 uvicorn

# Bind to 0.0.0.0 and the PORT environment variable provided by Cloud Run
CMD ["sh", "-c", "uvicorn sandbox_mcp:app --host 0.0.0.0 --port ${PORT:-8080}"]
