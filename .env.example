GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us
GEMINI_MODEL=gemini-3.5-flash

# Local Mission Control only. Generate two different printable secrets and do
# not use a VITE_ prefix; Vite-prefixed values are embedded in browser bundles.
MISSION_CONTROL_STATE_PATH=/private/tmp/ztm-mission-control.json
MISSION_CONTROL_API_TOKEN=
MISSION_CONTROL_ORCHESTRATOR_TOKEN=
MISSION_CONTROL_PROXY_TARGET=http://127.0.0.1:8080

# Browser identity. These are Firebase public application identifiers, not
# service-account credentials. Google sign-in creates a Firebase user on first
# successful authentication. Never place an Admin SDK private key in VITE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-side Firebase project used to verify browser ID tokens. Production
# owner/admin authorization must be configured from verified server identity;
# it is never inferred from browser input.
MISSION_CONTROL_FIREBASE_PROJECT_ID=
MISSION_CONTROL_WEB_STATE_PATH=

# Hosted Cloud Run profile. Use these instead of the two local *_STATE_PATH
# values. The service identity needs object access only to this private bucket.
MISSION_CONTROL_GCS_STATE_BUCKET=
MISSION_CONTROL_GCS_STATE_PREFIX=hosted-draft

# Hosted invitation policy. Keep these server-side; never use a VITE_ prefix.
# Admin emails are automatically included in the allowed set. In Cloud Run,
# prefer Secret Manager references instead of literal environment values.
MISSION_CONTROL_ALLOWED_EMAILS=
MISSION_CONTROL_ADMIN_EMAILS=
