    "analytics": "bigquery_downstream_only",
    "relay": "pubsub_sanitized_outbox",
    "approval": "cloud_sql_authority_only"
  },
  "resources": [
    {
      "id": "cloud-sql-authority",
      "kind": "cloud_sql_postgresql_ha_private_ip",
      "status": "planned",
      "ownerApprovalRequired": true,
      "requiredApis": ["sqladmin.googleapis.com", "servicenetworking.googleapis.com"],
      "purpose": "authoritative lifecycle approvals leases releases idempotency and sanitized outbox"
    },
    {
      "id": "authority-cmek",
      "kind": "cloud_kms_key",
      "status": "planned",
      "ownerApprovalRequired": true,
      "requiredApis": ["cloudkms.googleapis.com"],
      "purpose": "CMEK for explicitly approved persistent resources"
    },
    {
      "id": "outbox-events",
      "kind": "pubsub_topic",
      "status": "planned",
      "ownerApprovalRequired": true,
      "requiredApis": ["pubsub.googleapis.com"],
      "purpose": "sanitized committed-event delivery only"
    },
    {
      "id": "outbox-events-subscription",
      "kind": "pubsub_subscription",
      "status": "planned",
      "ownerApprovalRequired": true,
      "requiredApis": ["pubsub.googleapis.com"],
      "purpose": "relay delivery with stable event-id deduplication"
    },
    {
      "id": "outbox-events-dlq",
      "kind": "pubsub_dead_letter_topic",
      "status": "planned",
      "ownerApprovalRequired": true,
      "requiredApis": ["pubsub.googleapis.com"],
      "purpose": "visible failed outbox delivery without lifecycle mutation"
    },
    {
      "id": "migration-audit",
      "kind": "bigquery_dataset_and_append_only_audit_table",
      "status": "planned",
      "ownerApprovalRequired": true,
      "requiredApis": ["bigquery.googleapis.com"],
      "purpose": "downstream sanitized audit and reconciliation projection"
    },
    {
      "id": "vpc-service-perimeter",
      "kind": "vpc_service_controls_perimeter",
      "status": "planned",
      "ownerApprovalRequired": true,
      "requiredApis": ["accesscontextmanager.googleapis.com"],
      "purpose": "protect approved data-service egress boundaries"
    },
    {
      "id": "model-armor-policy",
      "kind": "model_armor_template",
      "status": "planned",
      "ownerApprovalRequired": true,
      "requiredApis": ["modelarmor.googleapis.com"],
      "purpose": "inspect only approved sanitized model and tool boundaries"
    }
  ],
  "identities": [
    {
      "id": "mission-control-runtime",
      "kind": "cloud_run_service_account",
      "bindings": [
        {"role": "roles/cloudsql.client", "resource": "cloud-sql-authority"},
        {"role": "roles/pubsub.publisher", "resource": "outbox-events"},
        {"role": "roles/cloudkms.cryptoKeyEncrypterDecrypter", "resource": "authority-cmek"}
      ]
    },
    {
      "id": "m3-schema-migrator",
      "kind": "external_workload_identity",
      "bindings": [
        {"role": "roles/cloudsql.admin", "resource": "cloud-sql-authority"},
        {"role": "roles/cloudkms.cryptoKeyEncrypterDecrypter", "resource": "authority-cmek"}
      ]
    },
    {
      "id": "outbox-relay",
      "kind": "cloud_run_service_account",
      "bindings": [
        {"role": "roles/pubsub.publisher", "resource": "outbox-events"},
        {"role": "roles/pubsub.subscriber", "resource": "outbox-events-subscription"}
      ]
    },
    {
      "id": "bigquery-audit-projector",
