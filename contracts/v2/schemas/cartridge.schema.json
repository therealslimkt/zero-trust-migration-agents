{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero-trust-migration.example/contracts/v2/2.0.0/cartridge.schema.json",
  "title": "Migration Contract v2 Cartridge Manifest",
  "description": "Versioned descriptor for one legacy source family adapter. The family set is closed and each family binds to exactly one product specialist, so a manifest cannot claim coverage it has no owner for.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cartridgeId",
    "family",
    "version",
    "displayName",
    "specialistId",
    "capabilities",
    "producesArtifactKinds",
    "claim",
    "cartridgeDigest",
    "publishedAt",
    "status"
  ],
  "properties": {
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "cartridgeId": {"type": "string", "pattern": "^crt_[a-z0-9][a-z0-9_]{2,47}$"},
    "family": {"$ref": "common.schema.json#/$defs/cartridgeFamily"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 120},
    "specialistId": {"$ref": "common.schema.json#/$defs/productAgentId"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "inventory_source",
          "profile_schema",
          "decode_records",
          "propose_mapping",
          "validate_plan",
          "reconcile_destination",
          "emit_lineage"
        ]
      }
    },
    "producesArtifactKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/artifactKind"}
    },
    "claim": {"$ref": "common.schema.json#/$defs/capabilityClaim"},
    "defaultBudget": {"$ref": "common.schema.json#/$defs/orchestrationBudget"},
    "cartridgeDigest": {
      "$ref": "common.schema.json#/$defs/digest",
      "description": "sha256 over the canonical JSON of this manifest with cartridgeDigest omitted."
    },
    "publishedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "superseded", "withdrawn"]
    },
    "deprecatedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "supersededBy": {"type": "string", "pattern": "^crt_[a-z0-9][a-z0-9_]{2,47}$"},
    "notes": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    }
  },
  "allOf": [
    {
      "description": "Each stable family binds to exactly one canonical specialist.",
      "oneOf": [
        {"properties": {"family": {"const": "sap_ecc_maxdb"}, "specialistId": {"const": "source_analyst_sap"}}},
        {"properties": {"family": {"const": "jde_e1_ibmi"}, "specialistId": {"const": "source_analyst_jde"}}},
        {"properties": {"family": {"const": "oracle_ebs"}, "specialistId": {"const": "source_analyst_oracle"}}},
        {"properties": {"family": {"const": "zos_cobol"}, "specialistId": {"const": "source_analyst_cobol"}}},
        {"properties": {"family": {"const": "ibmi_native"}, "specialistId": {"const": "source_analyst_ibmi"}}},
        {"properties": {"family": {"const": "sage_cre_zen"}, "specialistId": {"const": "source_analyst_sage"}}},
        {"properties": {"family": {"const": "dynamics_ax"}, "specialistId": {"const": "source_analyst_ax"}}}
      ]
    },
    {
      "description": "A superseded manifest must name its replacement; an active one must not.",
      "oneOf": [
        {"properties": {"status": {"const": "superseded"}}, "required": ["supersededBy"]},
        {
          "properties": {"status": {"enum": ["active", "deprecated", "withdrawn"]}},
          "not": {"required": ["supersededBy"]}
        }
      ]
    }
  ]
}
