{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero-trust-migration.example/contracts/v2/2.0.0/task-envelope.schema.json",
  "title": "Migration Contract v2 Task Envelope",
  "description": "Closed dispatch envelope. Field-for-field it is the generated TaskEnvelope from studio/src/control/contracts.generated.ts, plus the six v2 orchestration members: workflowId, workflowVersion, sessionId, orchestrationBudget, sourceInstanceIds, and optional parentTaskId. A worker receives no ambient authority beyond what this document states.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "traceId",
    "title",
    "objective",
    "ownerAgentId",
    "status",
    "readAllowlist",
    "readDenylist",
    "writeAllowlist",
    "networkPolicy",
    "acceptanceCriteria",
    "createdAt",
    "workflowId",
    "workflowVersion",
    "sessionId",
    "orchestrationBudget",
    "sourceInstanceIds"
  ],
  "properties": {
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "taskId": {"$ref": "common.schema.json#/$defs/taskId"},
    "traceId": {"$ref": "common.schema.json#/$defs/traceId"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "ownerAgentId": {"$ref": "common.schema.json#/$defs/agentId"},
    "reviewerAgentId": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/agentId"},
        {"type": "null"}
      ]
    },
    "status": {"$ref": "#/$defs/taskStatus"},
    "branch": {"type": ["string", "null"], "maxLength": 200},
    "workspace": {"type": ["string", "null"], "maxLength": 400},
    "readAllowlist": {"$ref": "#/$defs/pathList"},
    "readDenylist": {"$ref": "#/$defs/pathList"},
    "writeAllowlist": {"$ref": "#/$defs/pathList"},
    "contextRefs": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 400}
    },
    "networkPolicy": {"type": "string", "enum": ["deny", "allowlist"]},
    "allowedCommands": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 400}
    },
    "stopConditions": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 400}
    },
    "createdAt": {"$ref": "common.schema.json#/$defs/timestamp"},

    "workflowId": {"$ref": "common.schema.json#/$defs/workflowId"},
    "workflowVersion": {"$ref": "common.schema.json#/$defs/workflowVersion"},
    "sessionId": {"$ref": "common.schema.json#/$defs/sessionId"},
    "orchestrationBudget": {"$ref": "common.schema.json#/$defs/orchestrationBudget"},
    "sourceInstanceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/sourceInstanceId"}
    },
    "parentTaskId": {"$ref": "common.schema.json#/$defs/taskId"}
  },
  "$defs": {
    "taskStatus": {
      "type": "string",
      "description": "Unchanged from the generated TaskStatus union.",
      "enum": [
        "proposed",
        "queued",
        "running",
        "blocked",
        "review",
        "ready",
        "complete",
        "failed",
        "cancelled"
      ]
    },
    "pathList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400,
        "pattern": "^[A-Za-z0-9._*/-]+$",
        "description": "Repository-relative glob. Absolute paths and parent traversal are rejected by the pattern."
      },
      "not": {"contains": {"pattern": "\\.\\."}}
    }
  }
}
