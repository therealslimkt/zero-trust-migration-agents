{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero-trust-migration.example/contracts/v2/2.0.0/a2a-event.schema.json",
  "title": "Migration Contract v2 Agent-to-Agent Event",
  "description": "Closed inter-agent event. Members mirror the generated A2AEvent from studio/src/control/contracts.generated.ts, with a replay sequence required whenever orchestration metadata is present, a closed typed payload reference in place of the generated 'unknown' payload, and an optional typed 'orchestration' metadata block.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "traceId",
    "taskId",
    "from",
    "to",
    "type",
    "timestamp",
    "summary",
    "contextRefs",
    "artifactRefs",
    "status",
    "requiresHumanApproval"
  ],
  "properties": {
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "eventId": {"$ref": "common.schema.json#/$defs/eventId"},
    "traceId": {"$ref": "common.schema.json#/$defs/traceId"},
    "parentEventId": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/eventId"},
        {"type": "null"}
      ]
    },
    "taskId": {"$ref": "common.schema.json#/$defs/taskId"},
    "from": {"$ref": "common.schema.json#/$defs/agentId"},
    "to": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/agentId"},
        {"const": "broadcast"}
      ]
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,4}$",
      "maxLength": 120
    },
    "sequence": {
      "$ref": "common.schema.json#/$defs/sequence",
      "description": "v2 addition. Required with orchestration metadata and contiguous per run so workflow replay does not rely on wall-clock order."
    },
    "timestamp": {"$ref": "common.schema.json#/$defs/timestamp"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 280},
    "contextRefs": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 400}
    },
    "artifactRefs": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "common.schema.json#/$defs/artifactId"}
    },
    "status": {"$ref": "task-envelope.schema.json#/$defs/taskStatus"},
    "requiresHumanApproval": {"type": "boolean"},
    "payload": {
      "$ref": "#/$defs/eventPayload",
      "description": "v2 tightening. The generated shape typed this 'unknown'; on the wire it is now a closed content-addressed descriptor so the event stream cannot smuggle untyped data across a trust boundary."
    },
    "orchestration": {"$ref": "#/$defs/orchestrationMetadata"}
  },
  "oneOf": [
    {
      "required": ["orchestration", "sequence"]
    },
    {
      "not": {"required": ["orchestration"]}
    }
  ],
  "$defs": {
    "eventPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadKind", "digest"],
      "properties": {
        "payloadKind": {
          "type": "string",
          "enum": [
            "node_execution",
            "checkpoint",
            "interrupt_request",
            "interrupt_resume",
            "specialist_invocation",
            "reconciliation_result",
            "lineage_record",
            "policy_decision"
          ]
        },
        "digest": {"$ref": "common.schema.json#/$defs/digest"},
        "ref": {"$ref": "common.schema.json#/$defs/artifactReference"}
      }
    },
    "orchestrationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional typed orchestration context for one event. Present only for events emitted from inside a workflow run.",
      "required": [
        "pattern",
        "nodePath",
        "nodeRunId",
        "attempt",
        "isolationScope",
        "modelCall"
      ],
      "properties": {
        "pattern": {"$ref": "common.schema.json#/$defs/workflowPattern"},
        "nodePath": {"$ref": "common.schema.json#/$defs/nodePath"},
        "nodeRunId": {"$ref": "common.schema.json#/$defs/nodeRunId"},
        "parentNodeRunId": {"$ref": "common.schema.json#/$defs/nodeRunId"},
        "attempt": {"$ref": "common.schema.json#/$defs/attempt"},
        "route": {"$ref": "common.schema.json#/$defs/route"},
        "isolationScope": {"$ref": "common.schema.json#/$defs/isolationScope"},
        "modelCall": {"type": "boolean"},
        "checkpointRef": {"$ref": "common.schema.json#/$defs/checkpointReference"}
      }
    }
  }
}
