{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero-trust-migration.example/contracts/1.0.0/common.schema.json",
  "title": "Migration Contract Common Definitions",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^mig_[A-Za-z0-9]{12,64}$"
    },
    "sourceId": {
      "type": "string",
      "enum": ["jde", "maxdb", "btrieve"]
    },
    "runState": {
      "type": "string",
      "enum": [
        "created",
        "inventorying",
        "redacting",
        "planning",
        "awaiting_approval",
        "approved",
        "executing",
        "verifying",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "hostname"],
      "properties": {
        "sourceId": {"$ref": "#/$defs/sourceId"},
        "hostname": {
          "type": "string",
          "enum": ["legacy-jde-db", "legacy-maxdb", "legacy-btrieve-db"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "sourceId": {"const": "jde"},
            "hostname": {"const": "legacy-jde-db"}
          }
        },
        {
          "properties": {
            "sourceId": {"const": "maxdb"},
            "hostname": {"const": "legacy-maxdb"}
          }
        },
        {
          "properties": {
            "sourceId": {"const": "btrieve"},
            "hostname": {"const": "legacy-btrieve-db"}
          }
        }
      ]
    },
    "sourceSet": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/sourceDescriptor"},
      "allOf": [
        {"contains": {"required": ["sourceId"], "properties": {"sourceId": {"const": "jde"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["sourceId"], "properties": {"sourceId": {"const": "maxdb"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["sourceId"], "properties": {"sourceId": {"const": "btrieve"}}}, "minContains": 1, "maxContains": 1}
      ]
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "kind", "digest"],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^art_[A-Za-z0-9._-]{8,128}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "source_manifest",
            "redaction_report",
            "transform_plan",
            "dataflow_job",
            "bigquery_table",
            "reconciliation",
            "audit_log"
          ]
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "sourceProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "hostname", "state", "recordsRead", "recordsWritten", "recordsRejected"],
      "properties": {
        "sourceId": {"$ref": "#/$defs/sourceId"},
        "hostname": {
          "type": "string",
          "enum": ["legacy-jde-db", "legacy-maxdb", "legacy-btrieve-db"]
        },
        "state": {"$ref": "#/$defs/runState"},
        "recordsRead": {"type": "integer", "minimum": 0},
        "recordsWritten": {"type": "integer", "minimum": 0},
        "recordsRejected": {"type": "integer", "minimum": 0},
        "planDigest": {"$ref": "#/$defs/digest"},
        "failureCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        }
      },
      "oneOf": [
        {"properties": {"sourceId": {"const": "jde"}, "hostname": {"const": "legacy-jde-db"}}},
        {"properties": {"sourceId": {"const": "maxdb"}, "hostname": {"const": "legacy-maxdb"}}},
        {"properties": {"sourceId": {"const": "btrieve"}, "hostname": {"const": "legacy-btrieve-db"}}}
      ]
    }
  }
}
