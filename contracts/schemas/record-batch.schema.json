{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero-trust-migration.example/contracts/1.0.0/record-batch.schema.json",
  "title": "Sanitized Record Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "runId", "sourceId", "sourceManifestDigest", "recordSet", "schemaDigest", "recordCount", "records"],
  "properties": {
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "batchId": {"type": "string", "pattern": "^batch_[A-Za-z0-9]{12,64}$"},
    "runId": {"$ref": "common.schema.json#/$defs/runId"},
    "sourceId": {"$ref": "common.schema.json#/$defs/sourceId"},
    "sourceManifestDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "recordSet": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"},
    "schemaDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "recordCount": {"type": "integer", "minimum": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "ordinal", "values"],
      "properties": {
        "recordId": {"type": "string", "pattern": "^rec_[A-Za-z0-9]{8,64}$"},
        "ordinal": {"type": "integer", "minimum": 0},
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/protectedValue"}
        }
      }
    },
    "protectedValue": {
      "oneOf": [
        {"$ref": "#/$defs/sanitizedValue"},
        {"$ref": "#/$defs/tokenizedValue"}
      ]
    },
    "sanitizedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "protection", "value"],
      "properties": {
        "field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,127}$"},
        "protection": {"const": "sanitized"},
        "value": {
          "type": ["string", "integer", "number", "boolean", "null"]
        }
      }
    },
    "tokenizedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "protection", "value"],
      "properties": {
        "field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,127}$"},
        "protection": {"const": "tokenized"},
        "value": {"type": "string", "pattern": "^tok_[A-Za-z0-9_-]{8,256}$"}
      }
    }
  }
}
