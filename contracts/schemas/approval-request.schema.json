{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero-trust-migration.example/contracts/1.0.0/approval-request.schema.json",
  "title": "Portfolio Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planDigest", "decision", "decidedBy"],
  "properties": {
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "planDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "decision": {"type": "string", "enum": ["approve", "reject"]},
    "decidedBy": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9@._ -]*$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}
